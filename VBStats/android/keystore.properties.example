# Copy to android/keystore.properties and fill in with your own values.
# NEVER commit the real file or the .jks keystore itself.
#
# Path is relative to android/app/
MYAPP_UPLOAD_STORE_FILE=my-release-key.jks
MYAPP_UPLOAD_KEY_ALIAS=my-key-alias
MYAPP_UPLOAD_STORE_PASSWORD=REPLACE_ME
MYAPP_UPLOAD_KEY_PASSWORD=REPLACE_ME
