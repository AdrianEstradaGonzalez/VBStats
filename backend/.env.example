# ============================================
# DATABASE (MySQL)
# ============================================
# Option A: Full connection URL (recommended for remote providers like Railway, PlanetScale)
# MYSQL_PUBLIC_URL=mysql://root:password@host:port/database
MYSQL_PUBLIC_URL=

# Option B: Individual connection vars (local/private networks)
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database

# ============================================
# AUTHENTICATION
# ============================================
# Once every installed app build sends a session token, set this to true so requests
# without a valid token are rejected outright. Leave unset during the rollout, or old
# app versions will stop working. Raise MIN_APP_VERSION first to force the update.
STRICT_AUTH=false

# Accounts that get admin rights, comma separated. Replaces the hardcoded list that
# used to live in db.js.
SUPERADMIN_EMAILS=you@example.com

# Legacy /register endpoint (registration without email verification). Off by default.
ALLOW_LEGACY_REGISTER=false

# Browser origins allowed to call the API, comma separated. The mobile app sends no
# Origin header and is unaffected. Leave empty to allow no browser origins.
CORS_ORIGINS=

# ============================================
# STRIPE (Android/Web payments)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
# WARNING: Do NOT commit real secret keys. Set them in the deployment environment.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET

# Get from: Stripe Dashboard > Products > Prices
STRIPE_PRICE_BASIC=REPLACE_WITH_STRIPE_PRICE_BASIC
STRIPE_PRICE_PRO=REPLACE_WITH_STRIPE_PRICE_PRO

# Get from: Stripe Dashboard > Developers > Webhooks > Signing secret
# REQUIRED: without it every webhook is rejected and subscription state drifts.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# Shared secret used by server-side webhook handlers to elevate a subscription.
# Generate a long random value; there is no default any more.
SUBSCRIPTION_INTERNAL_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# ============================================
# APPLE IN-APP PURCHASES (iOS)
# ============================================
# App-Specific Shared Secret for receipt verification. Also authenticates the
# App Store server-to-server notifications endpoint.
# Get from: App Store Connect > My Apps > VBStats > App Information
APPLE_SHARED_SECRET=REPLACE_WITH_APPLE_SHARED_SECRET

# ============================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ============================================
# base64 of the service-account JSON from
# Firebase Console > Project settings > Service accounts > Generate new private key
# Encode with:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ============================================
# EMAIL (recuperación de contraseña y verificación de registro)
# ============================================
# Proveedor principal: Resend.
#   1. https://resend.com/domains → añade tu dominio
#   2. Copia los registros DNS que te da y créalos en tu proveedor de dominio
#   3. Espera a que los tres pasen a "Verified"
#   4. https://resend.com/api-keys → crea una clave con permiso de envío
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente. El dominio DEBE estar verificado en Resend o todos los envíos fallan.
EMAIL_FROM=VBStats <no-reply@tudominio.com>

# (Opcional) Respaldo por Gmail SMTP: se usa solo si Resend falla o no está
# configurado. Útil mientras el dominio termina de verificarse.
#   1. Activa la verificación en dos pasos en tu cuenta de Google
#   2. https://myaccount.google.com/apppasswords → crea una contraseña de aplicación
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ============================================
# GOOGLE SIGN-IN
# ============================================
# OAuth 2.0 "Web client" ID from Google Cloud Console (used to verify the idToken
# sent by the mobile app). This MUST be the Web client ID, not the Android/iOS one.
# The same value goes into VBStats/services/config.ts.
# Setup guide: VBStats/GOOGLE_SIGNIN_SETUP.md
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# ============================================
# APP CONFIGURATION
# ============================================
PORT=4000

# Deep link base used for Stripe success/cancel redirects
APP_URL=vbstats://

# Frontend URL for password reset links
FRONTEND_URL=https://vbstats.app

# Minimum required app version (forces update if lower)
# MIN_APP_VERSION=5.1

# Store URLs (for forced update redirects)
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.vbstats
# APP_STORE_URL=https://apps.apple.com/app/vbstats/idXXXXXXXXX
